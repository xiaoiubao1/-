<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/launcher_icon_calendar"
        android:label="随心记"
        android:roundIcon="@drawable/launcher_icon_calendar"
        android:supportsRtl="true"
        android:theme="@style/Theme.Suixinji">

        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <activity-alias
            android:name=".LauncherCalendar"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/launcher_icon_calendar"
            android:label="随心记"
            android:roundIcon="@drawable/launcher_icon_calendar"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherCheck"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/launcher_icon_check"
            android:label="随心记"
            android:roundIcon="@drawable/launcher_icon_check"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherGrid"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/launcher_icon_grid"
            android:label="随心记"
            android:roundIcon="@drawable/launcher_icon_grid"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherNote"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/launcher_icon_note"
            android:label="随心记"
            android:roundIcon="@drawable/launcher_icon_note"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".widget.EventWidgetProvider"
            android:exported="true"
            android:label="随心记概览">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/event_widget_info" />
        </receiver>
    </application>

</manifest>
